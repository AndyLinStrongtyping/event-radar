{
  "name": "event-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:web": "vite build --config frontend/vite.config.mjs",
    "prestart": "npm run build:web",
    "start": "node --env-file-if-exists=.env --experimental-strip-types src/server.ts",
    "start:prod": "node --experimental-strip-types src/server.ts",
    "prepreview": "npm run build:web",
    "preview": "node --env-file-if-exists=.env preview.cjs",
    "ingest": "node --env-file-if-exists=.env --experimental-strip-types src/ingest.ts",
    "sync": "node --env-file-if-exists=.env --experimental-strip-types src/sync-source.ts",
    "sync:domain": "node --env-file-if-exists=.env --experimental-strip-types src/sync-domain.ts",
    "review:performance": "node --env-file-if-exists=.env --experimental-strip-types src/review-performance-session-cli.ts",
    "review:marine-opening": "node --env-file-if-exists=.env --experimental-strip-types src/review-marine-opening-cli.ts",
    "sync:failed": "node --env-file-if-exists=.env --experimental-strip-types src/sync-source.ts --failed-only",
    "sync:status": "node --env-file-if-exists=.env --experimental-strip-types src/sync-status.ts",
    "jobs:enqueue": "node --env-file-if-exists=.env --experimental-strip-types src/source-job-cli.ts enqueue",
    "jobs:daily": "node --env-file-if-exists=.env --experimental-strip-types src/source-job-cli.ts daily",
    "jobs:scheduled": "node --env-file-if-exists=.env --experimental-strip-types src/source-job-cli.ts scheduled",
    "jobs:work": "node --env-file-if-exists=.env --experimental-strip-types src/source-job-cli.ts work",
    "jobs:status": "node --env-file-if-exists=.env --experimental-strip-types src/source-job-cli.ts status",
    "jobs:replay": "node --env-file-if-exists=.env --experimental-strip-types src/source-job-cli.ts replay",
    "coverage:baseline": "node --env-file-if-exists=.env --experimental-strip-types src/source-baseline-review-cli.ts",
    "review": "node --env-file-if-exists=.env --experimental-strip-types src/review.ts",
    "review:approve": "node --env-file-if-exists=.env --experimental-strip-types src/approve-review.ts",
    "admin": "node --env-file-if-exists=.env --experimental-strip-types src/admin-server.ts",
    "migrate": "node --env-file-if-exists=.env --experimental-strip-types src/migrate.ts",
    "check:chimei": "node --experimental-strip-types src/check-chimei.ts",
    "probe:chimei": "node --experimental-strip-types src/probe-chimei-source.ts",
    "probe:ntmofa": "node --experimental-strip-types src/probe-ntmofa.ts",
    "refresh:chimei:activities": "node --experimental-strip-types src/refresh-chimei-activities.ts",
    "import:chimei:programmes": "node --env-file-if-exists=.env --experimental-strip-types src/import-chimei-programmes.ts",
    "test": "node --experimental-strip-types --test test/*.test.ts test/*.test.mjs",
    "pretest:integration": "npm run build:web",
    "test:integration": "node --env-file-if-exists=.env test/ingest.integration.cjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p frontend/tsconfig.json",
    "check:docs": "node scripts/check-docs.mjs",
    "smoke:deploy": "node scripts/smoke-deploy.mjs",
    "backup:db": "node --env-file-if-exists=private/deployment-credentials.env scripts/db-backup.mjs backup",
    "restore:check": "node --env-file-if-exists=private/deployment-credentials.env scripts/db-backup.mjs restore-check",
    "test:backup": "node test/db-backup.integration.mjs"
  },
  "engines": {
    "node": ">=22.10"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "yaml": "^2.9.1"
  }
}
